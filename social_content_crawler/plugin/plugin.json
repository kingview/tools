{
  "schema_version": 1,
  "id": "com.socialagent.social-content",
  "name": "社媒浏览与下载",
  "version": "0.7.3",
  "description": "通过比特浏览器会话浏览抖音、小红书和 X，下载帖子媒体与文案，并在一次性授权后发布 X 帖子。",
  "publisher": "Social Agent",
  "platforms": ["macos-arm64", "windows-x64", "linux-x64"],
  "runtime": {
    "module": "social_content_crawler.mcp_server",
    "gui_module": "social_content_crawler.desktop",
    "install_extras": ["plugin"]
  },
  "tools": [
    {"name": "browse_posts"},
    {"name": "browser_operate"},
    {"name": "download_media"},
    {"name": "publish_x_post"}
  ],
  "permissions": ["network", "browser-session", "write-agent-output", "social-content-write"]
}
